# Copy this file to .env.local and fill in your own provider credentials.
# Never commit .env.local or paste real secrets into source code.

# Application / authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
PORT=3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/novexa

# IBM watsonx / Granite
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_API_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
WATSONX_TEMPERATURE=0.3
WATSONX_MAX_TOKENS=800
# Some legacy routes in this codebase also read WATSONX_URL.
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Speech-to-Text
WATSON_STT_API_KEY=your-watson-stt-api-key
WATSON_STT_URL=https://api.example.speech-to-text.watson.cloud.ibm.com/instances/your-instance-id

# IBM Watson Text-to-Speech (optional)
WATSON_TTS_API_KEY=your-watson-tts-api-key
WATSON_TTS_URL=https://api.example.text-to-speech.watson.cloud.ibm.com/instances/your-instance-id

# Legacy IBM service variable names used by some utility modules
IBM_STT_APIKEY=your-ibm-stt-api-key
IBM_STT_URL=https://api.example.speech-to-text.watson.cloud.ibm.com/instances/your-instance-id
IBM_TTS_APIKEY=your-ibm-tts-api-key
IBM_TTS_URL=https://api.example.text-to-speech.watson.cloud.ibm.com/instances/your-instance-id

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional meeting / realtime configuration
NEXT_PUBLIC_AGORA_APP_ID=your-agora-app-id
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_DISABLE_SOCKETIO=false
